rules_version = '2';

// NOTE: Cloud Functions use the Admin SDK and bypass these rules entirely
// (unzip writes to materials/{id}/extracted/…, serveScorm reads from it). These
// rules only govern direct client access.
service firebase.storage {
  match /b/{bucket}/o {

    // Training-material packages (admin uploads + extracted output). The upload
    // UI is only shown to managers, but Storage rules can't read the email-keyed
    // `admins` collection (no queries in rules), so we gate on "signed in" + a
    // size cap. Tighten to a custom claim (request.auth.token.admin) once one
    // exists — see the training-materials brainstorm.
    match /materials/{materialId}/{fileName=**} {
      allow read: if request.auth != null;
      // `write` = create/update/delete. request.resource is null on delete, so
      // allow that; cap uploads at 500 MB.
      allow write: if request.auth != null
                   && (request.resource == null
                       || request.resource.size < 500 * 1024 * 1024);
    }

    // Everything else stays locked.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
